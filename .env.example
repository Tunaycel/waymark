# Copy to .env and fill in. Never commit .env.

# Postgres (docker-compose default)
DATABASE_URL=postgres://waymark:waymark@localhost:5433/waymark

# Redis (docker-compose default)
REDIS_URL=redis://localhost:6380

# GitHub App webhook secret — the same value you set in the App settings.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_WEBHOOK_SECRET=

# HTTP server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Set to 1 when running behind one reverse proxy / tunnel you control (ngrok, Fly, nginx).
TRUST_PROXY_HOPS=0
