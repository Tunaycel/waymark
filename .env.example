# Copy to .env and fill in. Never commit .env.

# Postgres (docker-compose default)
DATABASE_URL=postgres://waymark:waymark@localhost:5433/waymark

# Redis (docker-compose default)
REDIS_URL=redis://localhost:6380

# GitHub App webhook secret — the same value you set in the App settings.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_WEBHOOK_SECRET=

# GitHub App credentials for repository indexing (worker). Optional: without them the worker only
# ingests pushes. See docs/GITHUB_APP.md. The key may be on one line with 
 for line breaks.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# GitHub Enterprise Server: https://HOST/api/v3
# GITHUB_API_URL=https://api.github.com

# HTTP server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Set to 1 when running behind one reverse proxy / tunnel you control (ngrok, Fly, nginx).
TRUST_PROXY_HOPS=0
