{
  "name": "waymark",
  "private": true,
  "description": "Personal agent that maps your projects, reviews your work, and tells you where you left off.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "dev": "turbo run dev --parallel",
    "db:generate": "pnpm --filter @waymark/db generate",
    "db:migrate": "pnpm --filter @waymark/db migrate",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "bench": "pnpm --filter @waymark/scripts bench",
    "map:local": "pnpm --filter @waymark/indexer map",
    "bench:index": "pnpm --filter @waymark/scripts bench:index"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^24.19.2",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
